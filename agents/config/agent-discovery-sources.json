      "repo_field": "repo"
    },
    {
      "id": "openclaw_showcase",
      "kind": "html",
      "url": "https://openclaw.ai/showcase"
    },
    {
      "id": "clawhub",
      "kind": "clawhub",
      "url": "https://clawhub.ai/",
      "detail_limit": 500
    },
    {
      "id": "openclaw_github",
      "kind": "github_repo",
      "url": "https://github.com/openclaw/openclaw"
    },
    {
      "id": "hermes_atlas",
      "kind": "html",
      "url": "https://hermesatlas.com/ecosystem/"
    },
    {
      "id": "hermes_atlas_github",
      "kind": "github_repo",
      "url": "https://github.com/ksimback/hermes-ecosystem"
    },
    {
      "id": "awesome_hermes_agent",
      "kind": "github_readme",
      "url": "https://github.com/0xarkstar/awesome-hermes-agent"
    },
    {
      "id": "hermes_showcase_reddit",
      "kind": "reddit",
      "url": "https://www.reddit.com/r/hermesagent/comments/1w631p8/showcase_thursday_drop_your_hermes_projects_here/"
    },
    {
      "id": "hermes_use_cases_reddit",
      "kind": "reddit",
